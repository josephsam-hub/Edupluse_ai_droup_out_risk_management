# ================================================================
# EduPulse AI - Environment Variables Template
# ================================================================
# Copy this file to .env and fill in your own values.
# NEVER commit the actual .env file to version control.
# ================================================================

# ----------------------------------------------------------------
# Security / JWT
# ----------------------------------------------------------------
# Generate a strong secret key with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=your-secret-key-here-change-in-production-must-be-at-least-32-chars
ALGORITHM=HS256
# Token expiry in minutes (1440 = 24 hours)
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ----------------------------------------------------------------
# Database
# ----------------------------------------------------------------
# DB_TYPE: "postgresql" (default) or "sqlite"
DB_TYPE=postgresql

# PostgreSQL settings (used when DATABASE_URL is not set)
PG_HOST=localhost
PG_PORT=5432
PG_USER=postgres
PG_PASSWORD=your_postgres_password_here
PG_DATABASE=edupulse_ai
# Connection pool settings
PG_POOL_SIZE=10
PG_MAX_OVERFLOW=20
# Alternatively, provide a complete URL:
# DATABASE_URL=postgresql+psycopg://postgres:password@localhost:5432/edupulse_ai

# ----------------------------------------------------------------
# Application
# ----------------------------------------------------------------
# ENV: "development" | "staging" | "production"
ENV=development
DEBUG=true

# Comma-separated list of allowed CORS origins
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# Backend host / port (used in uvicorn startup scripts)
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# ----------------------------------------------------------------
# ML Model
# ----------------------------------------------------------------
# Path to the trained model file (joblib pickle)
MODEL_PATH=./ml/models/risk_model.joblib
# Path to the label encoder / scaler artifacts
SCALER_PATH=./ml/models/scaler.joblib
# Model version tag (must match a row in model_metrics table)
MODEL_VERSION=1.0

# ----------------------------------------------------------------
# Frontend (Vite / React)
# ----------------------------------------------------------------
# Prefix ALL Vite env vars with VITE_ so they are exposed to the browser
VITE_API_URL=http://localhost:8000
VITE_APP_NAME=EduPulse AI
VITE_APP_VERSION=1.0.0

# ----------------------------------------------------------------
# Logging
# ----------------------------------------------------------------
LOG_LEVEL=INFO
# "console" | "file" | "both"
LOG_OUTPUT=console
LOG_FILE_PATH=./logs/edupulse.log

# ----------------------------------------------------------------
# Email / SMTP (optional — for notification emails)
# ----------------------------------------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
EMAIL_FROM=noreply@edupulse.ai
EMAIL_ENABLED=false
